# ── Supabase ────────────────────────────────────────────────────────────────
# 프로젝트 설정 > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 않는다. 클라이언트에 노출되면 DB가 통째로 열린다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 초대 링크 통행증 ────────────────────────────────────────────────────────
# 32자 이상. 만들기:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LEDGER_COOKIE_SECRET=

# ── 영수증 분석 ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# 장부 하나당 한 달 분석 횟수 상한. 넘으면 수동 입력으로 안내한다.
LEDGER_AI_MONTHLY_LIMIT=200

# ── 카카오 ──────────────────────────────────────────────────────────────────
# 카카오 로그인 버튼을 띄울지. 1 일 때만 보인다.
# Supabase는 카카오에 account_email 을 반드시 요구하는데, 그 동의항목은
# 카카오 앱을 비즈앱으로 전환해야 켤 수 있다. 전환 전에는 눌러도 KOE205 가 뜨므로
# 비워 두어 버튼 자체를 감춘다.
NEXT_PUBLIC_KAKAO_LOGIN=

# 카카오톡 공유(JavaScript SDK)에 쓰는 JavaScript 키.
# 카카오 로그인 자체는 Supabase Auth가 처리하므로 여기 키가 아니라
# Supabase 대시보드의 Kakao provider 설정에 REST API 키와 Client Secret을 넣는다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 광고 ────────────────────────────────────────────────────────────────────
# 애드센스는 품목·아카이브 화면에만 들어간다. 장부·정산 화면에는 넣지 않는다.
# 값이 비어 있으면 광고 슬롯 자체가 렌더되지 않는다.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# 영수증 읽기에 쓰는 모델. 비우면 claude-sonnet-4-5.
# 한국어 상품명 정확도가 중요해서 기본값을 Sonnet으로 둔다.
# 값을 낮추려면 claude-haiku-4-5 (약 1/4 값, 이름이 조금씩 틀림)
LEDGER_AI_MODEL=

# ── 길잡이 (§21.10) ─────────────────────────────────────────────────────────
# "개발자에게 커피 사주기". 둘 다 비워 두면 그 항목 자체가 안 보인다.
#
# 계좌를 그대로 두는 쪽이 제일 확실하다. 개인 송금 링크(toss.me 같은 것)는
# 서비스가 닫히면 그날로 죽은 링크가 되지만, 계좌번호는 은행이 있는 한 산다.
# 누르면 복사된다.
NEXT_PUBLIC_COFFEE_ACCOUNT=
# 예: NEXT_PUBLIC_COFFEE_ACCOUNT=카카오뱅크 3333-00-0000000 홍길동

# 후원 페이지가 따로 있으면 그 주소. (GitHub Sponsors, Ko-fi 등)
NEXT_PUBLIC_COFFEE_URL=

# 장부에 대해 묻는 기능도 위의 ANTHROPIC_API_KEY 를 쓴다.
# 키가 없으면 도우미는 말풍선과 재주만 부리고, 묻는 자리는 뜨지 않는다.
